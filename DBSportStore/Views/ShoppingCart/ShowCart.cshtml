@model DBSportStore.Models.Cart
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}
<h2 class="section-title">Giỏ hàng của bạn</h2>

@if (TempData["CartError"] != null)
{
    <div class="alert alert-danger">@TempData["CartError"]</div>
}
@if (TempData["CartSuccess"] != null)
{
    <div class="alert alert-success">@TempData["CartSuccess"]</div>
}

@if (Model == null || !Model.Items.Any())
{
    <div class="catalog-empty">
        <h3>Giỏ hàng đang trống</h3>
        <p>Hãy chọn sản phẩm trước khi thanh toán.</p>
        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Store", null, new { @class = "btn-brand" })
    </div>
}
else
{
    <div style="overflow-x:auto;">
        <table class="table table-bordered" style="background:#fff;vertical-align:middle;">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (!String.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content("~/Content/images/" + item.ImageUrl)" alt="@item.ProductName"
                                     style="width:70px;height:70px;object-fit:cover;margin-right:10px;" />
                            }
                            <strong>@item.ProductName</strong>
                        </td>
                        <td>@item.UnitPrice.ToString("#,##0") đ</td>
                        <td style="min-width:160px;">
                            @using (Html.BeginForm("UpdateQuantity", "ShoppingCart", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1"
                                       max="@item.StockQuantity" style="width:75px;" />
                                <button type="submit" class="btn-soft">Cập nhật</button>
                            }
                            <small>Còn @item.StockQuantity</small>
                        </td>
                        <td>@item.LineTotal.ToString("#,##0") đ</td>
                        <td>
                            @using (Html.BeginForm("RemoveFromCart", "ShoppingCart", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <button type="submit" class="btn-soft">Xóa</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" style="text-align:right;">Tổng cộng</th>
                    <th colspan="2">@Model.TotalMoney().ToString("#,##0") đ (@Model.TotalQuantity() sản phẩm)</th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin:20px 0;">
        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Store", null, new { @class = "btn-soft" })
        @Html.ActionLink("Tiến hành thanh toán", "Checkout", "ShoppingCart", null, new { @class = "btn-brand" })
    </div>
}