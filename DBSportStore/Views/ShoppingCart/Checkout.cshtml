@model DBSportStore.Models.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}
<h2 class="section-title">Thông tin thanh toán</h2>

@if (!ViewData.ModelState.IsValid)
{
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
}

<div class="store-shell" style="grid-template-columns:minmax(0,1.4fr) minmax(280px,0.8fr);">
    <section class="auth-card">
        @using (Html.BeginForm("Checkout", "ShoppingCart", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                @Html.LabelFor(m => m.FullName)
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FullName)
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Phone)
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Address)
                @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Address)
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.ShippingAddress)
                @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ShippingAddress)
            </div>
            <button type="submit" class="btn-brand">Đặt hàng</button>
            @Html.ActionLink("Quay lại giỏ hàng", "ShowCart", "ShoppingCart", null, new { @class = "btn-soft" })
        }
    </section>

    <aside class="category-panel">
        <h3>Đơn hàng của bạn</h3>
        @if (Model.CartItems != null)
        {
            foreach (var item in Model.CartItems)
            {
                <p>@item.ProductName × @item.Quantity
                    <strong style="float:right;">@item.LineTotal.ToString("#,##0") đ</strong>
                </p>
            }
        }
        <hr />
        <h3>Tổng tiền: @Model.TotalAmount.ToString("#,##0") đ</h3>
    </aside>
</div>