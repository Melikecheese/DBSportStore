@* Layout chung của SportStore; menu thay đổi theo trạng thái đăng nhập. *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SportStore</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/sportstore.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="store-topbar">
        <div class="container">Miễn phí giao hàng cho đơn từ 1.000.000đ</div>
    </div>
    <header class="store-header">
        <div class="container">
            <a class="brand" href="@Url.Action("Index", "Store")">SPORT<span>STORE</span></a>
            <nav class="store-nav">
                @Html.ActionLink("Giới thiệu", "AboutStore", "Store")
                @Html.ActionLink("Trang chủ", "Index", "Store")
                @Html.Action("BagCart", "ShoppingCart")

                @if (Session["UserID"] == null)
                {
                    @Html.ActionLink("Đăng ký", "SignUp", "Account")
                    @Html.ActionLink("Đăng nhập", "Login", "Account")
                }
                else
                {
                    if (Convert.ToString(Session["Role"]) == "Admin")
                    {
                        @Html.ActionLink("Quản trị", "Index", "Admin")
                        @Html.ActionLink("Sản phẩm", "Index", "Products")
                        @Html.ActionLink("Danh mục", "Index", "Categories")
                    }

                    <span class="nav-user">Xin chào @(Session["FullName"] ?? Session["UserName"])</span>
                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "nav-logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link-button">Đăng xuất</button>
                    }
                }
            </nav>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="store-footer">
        <div class="container">
            <strong>SPORTSTORE</strong><br />
            Website thương mại thực hành ASP.NET MVC5
        </div>
    </footer>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>