@model DBSportStore.Models.SignUpViewModel
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}
<div class="auth-page">
    <div class="auth-card">
        <h2>Đăng ký tài khoản</h2>
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        @using (Html.BeginForm("SignUp", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">@Html.LabelFor(m => m.UserName) @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.UserName)</div>
            <div class="form-group">@Html.LabelFor(m => m.Password) @Html.PasswordFor(m => m.Password, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Password)</div>
            <div class="form-group">@Html.LabelFor(m => m.ConfirmPassword) @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.ConfirmPassword)</div>
            <div class="form-group">@Html.LabelFor(m => m.FullName) @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.FullName)</div>
            <div class="form-group">@Html.LabelFor(m => m.Phone) @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Phone)</div>
            <div class="form-group">@Html.LabelFor(m => m.Email) @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" }) @Html.ValidationMessageFor(m => m.Email)</div>
            <div class="form-group">@Html.LabelFor(m => m.Address) @Html.TextBoxFor(m => m.Address, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Address)</div>
            <button type="submit" class="btn-brand">Tạo tài khoản</button>
        }
        <p>Đã có tài khoản? @Html.ActionLink("Đăng nhập", "Login")</p>
    </div>
</div>